generator client {
  provider        = "prisma-client-js"
  output          = "../src/prisma"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  ADMIN
}

enum QuizStatus {
  IN_PROGRESS
  COMPLETED
  EXPIRED
  ABANDONED
}

enum AnswerStatus {
  PENDING
  ANSWERED
  SKIPPED
  REVIEWING
}

model QuizAttempt {
  id             String     @id @default(cuid())
  userId         String
  topicId        String?
  moduleId       String?
  totalQuestions Int
  questionsData  String     // JSON string of questions
  settings       String     // JSON string of quiz settings
  status         QuizStatus @default(IN_PROGRESS)
  score          Int?
  startedAt      DateTime   @default(now())
  completedAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic            Topic?            @relation(fields: [topicId], references: [id], onDelete: SetNull)
  module           Module?           @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  questionAttempts QuestionAttempt[]

  @@index([userId])
  @@index([topicId])
  @@index([moduleId])
  @@index([status])
  @@index([startedAt])
  @@map("quiz_attempts")  // Map to match your naming convention (snake_case)
}

model QuestionAttempt {
  id               String       @id @default(cuid())
  quizAttemptId    String
  questionId       String
  selectedAnswerId String?
  isCorrect        Boolean?     @default(false)
  order            Int
  status           AnswerStatus @default(PENDING)
  answeredAt       DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  quizAttempt    QuizAttempt @relation(fields: [quizAttemptId], references: [id], onDelete: Cascade)
  question       Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedAnswer Answer?     @relation(fields: [selectedAnswerId], references: [id], onDelete: SetNull)

  @@unique([quizAttemptId, questionId])
  @@index([quizAttemptId])
  @@index([questionId])
  @@index([status])
  @@index([answeredAt])
  @@map("question_attempts")  // Map to match your naming convention (snake_case)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role      @default(STUDENT)
  streakDays    Int       @default(0)
  lastVisitDate DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  userAnswers   UserAnswer[]
  timetables    Timetable[]
  notifications Notification[]
  enrollments   ModuleEnrollment[]
  quizAttempts  QuizAttempt[]
  sentFriendRequests     Friendship[]   @relation("FriendshipSender")
  receivedFriendRequests Friendship[]   @relation("FriendshipReceiver")
  conversationsAsUser1   Conversation[] @relation("ConversationUser1")
  conversationsAsUser2   Conversation[] @relation("ConversationUser2")
  sentMessages           Message[]      @relation("MessageSender")
  @@map("users")
  
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Module {
  id          String   @id @default(cuid())
  title       String
  description String?
  createdAt   DateTime @default(now())

  chapters     Chapter[]
  timetables   Timetable[]
  enrollments  ModuleEnrollment[]
  quizAttempts QuizAttempt[]

  @@map("modules")
}

model ModuleEnrollment {
  id         String   @id @default(cuid())
  userId     String
  moduleId   String
  enrolledAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId])
  @@index([userId])
  @@index([moduleId])
  @@map("module_enrollments")
}

model Chapter {
  id        String   @id @default(cuid())
  moduleId  String
  title     String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  module Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  topics Topic[]

  @@index([moduleId])
  @@map("chapters")
}

model Topic {
  id        String   @id @default(cuid())
  chapterId String
  title     String
  content   String?  @db.Text
  order     Int      @default(0)
  createdAt DateTime @default(now())
  assignment String? @db.Text

  chapter      Chapter       @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  questions    Question[]
  flashcards   Flashcard[]
  quizAttempts QuizAttempt[]
  pdfs         TopicPdf[]

  @@index([chapterId])
  @@map("topics")
}

model TopicPdf {
  id        String   @id @default(cuid())
  topicId   String
  title     String
  url       String   @db.Text
  pathname  String?  @db.Text
  createdAt DateTime @default(now())

  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId])
  @@map("topic_pdfs")
}

model Assignment_Attempt {
  id         String   @id @default(cuid())
  topicId    String
  userId     String
  percentage Int
  passed     Boolean 
  createdAt  DateTime @default(now())
}

model Question {
  id         String   @id @default(cuid())
  topicId    String
  question   String   @db.Text
  difficulty String   @default("medium")
  createdAt  DateTime @default(now())

  topic            Topic             @relation(fields: [topicId], references: [id], onDelete: Cascade)
  answers          Answer[]
  userAnswers      UserAnswer[]
  questionAttempts QuestionAttempt[]

  @@index([topicId])
  @@map("questions")
}

model Answer {
  id         String  @id @default(cuid())
  questionId String
  answer     String  @db.Text
  isCorrect  Boolean @default(false)

  question         Question          @relation(fields: [questionId], references: [id], onDelete: Cascade)
  userAnswers      UserAnswer[]
  questionAttempts QuestionAttempt[]

  @@index([questionId])
  @@map("answers")
}

model UserAnswer {
  id               String   @id @default(cuid())
  userId           String
  questionId       String
  selectedAnswerId String?
  isCorrect        Boolean
  answeredAt       DateTime @default(now())

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question       Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedAnswer Answer?  @relation(fields: [selectedAnswerId], references: [id], onDelete: SetNull)

  @@index([userId, questionId])
  @@map("user_answers")
}

model Flashcard {
  id        String   @id @default(cuid())
  topicId   String
  front     String   @db.Text
  back      String   @db.Text
  createdAt DateTime @default(now())

  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId])
  @@map("flashcards")
}

model Timetable {
  id                String   @id @default(cuid())
  userId            String
  moduleId          String?
  assignmentTitle   String
  startDate         DateTime
  dueDate           DateTime
  chaptersPlanned   Int      @default(0)
  chaptersCompleted Int      @default(0)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  module Module? @relation(fields: [moduleId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("timetable")
}

model Notification {
  id          String   @id @default(cuid())
  userId      String
  title       String
  scheduledAt DateTime
  isSent      Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, scheduledAt])
  @@map("notifications")
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum MessageType {
  TEXT
  IMAGE
  VOICE
}

model Friendship {
  id         String           @id @default(cuid())
  senderId   String
  receiverId String
  status     FriendshipStatus @default(PENDING)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  sender   User @relation("FriendshipSender",   fields: [senderId],   references: [id], onDelete: Cascade)
  receiver User @relation("FriendshipReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([senderId])
  @@index([receiverId])
  @@index([status])
}

model Conversation {
  id        String   @id @default(cuid())
  user1Id   String
  user2Id   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user1    User      @relation("ConversationUser1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2    User      @relation("ConversationUser2", fields: [user2Id], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([user1Id, user2Id])
  @@index([user1Id])
  @@index([user2Id])
  @@index([updatedAt])
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  senderId       String
  type           MessageType @default(TEXT)
  content        String?     @db.Text
  mediaUrl       String?
  mediaDuration  Int?
  readAt         DateTime?
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}
