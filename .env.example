# Tyro Study environment variables.
# Copy to .env.local and fill in. Never commit .env.local or real values.
# Production values live only in Vercel → Project → Settings → Environment Variables.

# --- Database (PostgreSQL) ---------------------------------------------------
# Local development: the Docker database from docker-compose.yml (npm run db:up).
# Do NOT point local development at the production Neon database.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tyro_study"
# Direct (non-pooled) connection, used by Prisma migrations. On Neon this is the
# host WITHOUT "-pooler". Locally it's the same as DATABASE_URL.
DIRECT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tyro_study"

# --- Auth (NextAuth) ------------------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:4000"
APP_URL="http://localhost:4000"

# --- Email (Resend) -------------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="Tyro Study <no-reply@tyrostudy.co.za>"

# --- Files (Vercel Blob) ----------------------------------------------------------
BLOB_READ_WRITE_TOKEN=""

# --- Real-time chat (Pusher) -----------------------------------------------------
PUSHER_APP_ID=""
PUSHER_SECRET=""
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER=""

# --- Push notifications (Web Push / VAPID) -----------------------------------------
# Generate a key pair with: node scripts/generate-vapid-keys.mjs
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# --- AI (OpenAI) -------------------------------------------------------------------
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# --- Video finder (YouTube Data API) ------------------------------------------------
YOUTUBE_API_KEY=""

# --- Scheduled jobs ----------------------------------------------------------------
# Protects /api/cron/reminders. Generate with: openssl rand -hex 32
CRON_SECRET=""

# --- Seeding a local admin (npm run db:seed) -----------------------------------------
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# --- Deployment (set in Vercel, not locally) -------------------------------------------
# 1 = apply pending migrations during the build. Only for Preview variables scoped to
# the `main` branch (staging), whose DATABASE_URL is the Neon `staging` branch.
# Never in Production: the release workflow migrates production (docs/runbooks/release.md).
# MIGRATE_ON_BUILD=

# --- Feature flags and release switches (src/lib/flags.ts, business/10) -------------------
# on | off | admins | 25%   (unset = the default in flags.ts). Change in Vercel, then redeploy.
# FLAG_HIGHSCHOOL_SIGNUP=on
# FLAG_ANALYTICS=on
# HSTS max-age in seconds: 86400 for v1.0.0, raised in stages. HSTS_PRELOAD=1 only at the end.
# HSTS_MAX_AGE=86400
# SECURITY_HEADERS=off removes all security headers (emergency only).

# --- Monitoring and incidents (business/11) ----------------------------------------------
# Unlocks /api/health details (errors, job heartbeats) for the monitor workflow.
# Same value as the GitHub secret MONITOR_TOKEN. Generate with: openssl rand -hex 32
MONITOR_TOKEN=
# Who gets the daily ops email (comma-separated). Default: the site contact address.
OPS_EMAIL=
# Minutes without a successful reminders run before monitoring complains (default 30).
# REMINDERS_STALE_MINUTES=30
# Site-wide notice during an incident (redeploy to show/remove). STATUS_LEVEL=info|warning
# STATUS_MESSAGE=
# STATUS_LEVEL=warning
# LOG_DEBUG=1 prints debug-level log lines.
